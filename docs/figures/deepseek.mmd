flowchart TD
    subgraph Front["1 · Front door & per-statement execution"]
        Engine["Engine<br/><i>CLI: no args · 1 arg · -f script</i>"]
        Executor["Executor<br/><i>statement counter → MDC</i>"]
    end

    subgraph SQL["2 · SQL front end — dk.itu.swandb.sql"]
        SqlParser["SqlParser<br/><i>parse(String) → List&lt;Statement&gt;</i>"]
        SqlAstBuilder["SqlAstBuilder<br/><i>ANTLR visitor</i>"]
        AST["sql/ast/<br/><i>Statement · SelectStatement<br/>CreateTableStatement · CopyStatement · Predicate</i>"]
        Binder["Binder<br/><i>validate vs. schema; no scan</i>"]
        SqlPrinter["SqlPrinter<br/><i>parse(print(s)).equals(s)</i>"]
    end

    subgraph Plan["3 · Planning & Volcano operators — dk.itu.swandb.plan"]
        Planner["Planner<br/><i>ONLY user of min/max</i>"]
        Pruning["Pruning / MinMax"]
        PlanObj["Plan<br/><i>root + ScanStats</i>"]
        Selection["Selection"]
        Operator["Operator<br/><i>open · next · close</i>"]
        FilterOperator["FilterOperator"]
        ScanOperator["ScanOperator<br/><i>sees no predicate</i>"]
    end

    subgraph Store["4 · Storage — dk.itu.swandb"]
        StorageEngine["StorageEngine<br/><i>createTable · copyFile<br/>select · selectAll · schema</i>"]
        SwanFile["SwanFile<br/><i>header + partitions</i>"]
        ValueCodec["ValueCodec"]
        Catalog["Catalog<br/><i>in-memory document</i>"]
    end

    subgraph CSV["5 · CSV in / out"]
        CsvParser["CsvParser"]
        CsvWriter["CsvWriter"]
    end

    subgraph Log["6 · Observability — one 7-field CSV line per call"]
        LogFormat["LogFormat.sanitize<br/><i>comma → ';'</i>"]
    end

    subgraph Disk["On disk & streams"]
        CatalogJson[("catalog.json")]
        SwanData[(".swan (per table)")]
        Stdout(["stdout"])
        Stderr(["stderr"])
    end

    Gen{{"generated by ANTLR<br/>target/generated-sources"}}

    %% ---- build-time code generation ----
    Gen -.->|"build time"| SqlParser

    %% ---- request path down ----
    Engine -->|"SQL text"| Executor
    Executor -->|"whole script"| SqlParser
    SqlParser -->|"parse tree"| SqlAstBuilder
    SqlAstBuilder -->|"AST records"| AST
    AST -->|"Statement"| Binder
    Binder -->|"validated statement"| Planner
    Planner -->|"Selection (WHERE only)"| Selection
    Planner -->|"canPrune(predicate, MinMax)"| Pruning
    Planner -->|"builds"| PlanObj
    Planner -->|"surviving partition offsets"| ScanOperator
    Planner -.->|"wraps scan when WHERE present"| FilterOperator
    FilterOperator -.->|"implements"| Operator
    ScanOperator -.->|"implements"| Operator

    %% ---- validation reads the schema only ----
    Binder -.->|"schema(table) — read-only"| StorageEngine

    %% ---- DDL / ingest path ----
    Executor -->|"CREATE TABLE / COPY"| StorageEngine
    StorageEngine -->|"parse input CSV"| CsvParser
    StorageEngine -->|"write partitions,<br/>return byte offsets"| SwanFile
    StorageEngine -->|"update schema, MinMax,<br/>partition offsets"| Catalog

    %% ---- Volcano pull: driven by StorageEngine.drain ----
    StorageEngine -.->|"drain(root): open / next"| FilterOperator
    StorageEngine -.->|"drain(root): open / next"| ScanOperator
    ScanOperator -->|"next()"| FilterOperator
    FilterOperator -->|"next()"| StorageEngine

    %% ---- storage reads ----
    ScanOperator -->|"seek to stored offset,<br/>read one partition"| SwanFile
    SwanFile <-->|"encode / decode"| ValueCodec
    StorageEngine -->|"pruning input: partitions + offsets"| Catalog

    %% ---- materialised results ----
    StorageEngine -->|"List&lt;Object[]&gt; rows<br/>(fully drained)"| Executor
    Executor -->|"per-statement rows"| Engine
    Engine -->|"writeRows(System.out, rows)"| CsvWriter
    CsvWriter -->|"headerless CSV"| Stdout
    SqlPrinter -.->|"round-trip render"| AST
    CatalogJson <-.->|"load() on startup /<br/>whole-document save()"| Catalog
    SwanData <-.->|"write file / seek & read"| SwanFile

    %% ---- observability: only Engine, StorageEngine, Planner sanitize ----
    Engine -.->|"start / stop / failure"| LogFormat
    StorageEngine -.->|"create · copy · partition<br/>read / prune · summaries"| LogFormat
    Planner -.->|"pruning decisions,<br/>BEFORE any .swan opens"| LogFormat
    LogFormat -.->|"Log4j2"| Stderr